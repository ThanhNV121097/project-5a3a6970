# Local Postgres user.
POSTGRES_USER=app

# Local Postgres password; example only.
POSTGRES_PASSWORD=app_secret

# Local Postgres database.
POSTGRES_DB=app

# Host port mapped to backend.
BACKEND_PORT=8080

# Host port mapped to frontend.
FRONTEND_PORT=3000

# Browser-visible API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8080
